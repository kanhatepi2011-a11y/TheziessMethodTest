# Telegram Web Login (BotFather → Bot Settings → Web Login)
TELEGRAM_CLIENT_ID=123456789
TELEGRAM_CLIENT_SECRET=replace_with_client_secret_from_botfather

# Strongly recommended on Vercel. It must exactly match one of the Allowed URLs
# configured in BotFather. Replace with your stable production domain.
TELEGRAM_REDIRECT_URI=https://your-project.vercel.app/api/auth/telegram/callback

# Used to sign the HTTP-only login cookie. Use 24+ random characters.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_24_characters

# PostgreSQL connection string from Neon, Supabase, Railway, or another provider.
# On Vercel/Neon, use the pooled connection string when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Telegram admin bot (BotFather token for the bot that receives admin commands).
# This may be the same bot connected to Telegram Web Login.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_real_bot_token

# Comma-separated Telegram user IDs allowed to view users and subscriptions.
# Send /id to the bot after webhook setup to see your own Telegram ID.
TELEGRAM_ADMIN_IDS=123456789

# Random webhook secret: 1-256 letters, numbers, underscore or hyphen only.
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret_123

# Random setup password used only when calling POST /api/telegram/setup.
TELEGRAM_SETUP_KEY=replace_with_a_long_random_setup_password

# Optional date/time zone used in admin messages.
ADMIN_TIMEZONE=Asia/Phnom_Penh
