# Vercel Project Settings → Environment Variables
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_real_bot_token
SESSION_SECRET=replace_with_a_long_random_secret_at_least_24_characters

# PostgreSQL connection string from Neon, Supabase, Railway, or another PostgreSQL provider.
# On Vercel/Neon, use the pooled connection string when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
